{
  "expo": {
    "name": "DACN1 Driver",
    "slug": "dacn1-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dacn1.drivermonitor",
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng cần quyền camera để đăng ký khuôn mặt tài xế."
      }
    },
    "android": {
      "package": "com.dacn1.drivermonitor",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#020617"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép DACN1 sử dụng camera để đăng ký khuôn mặt tài xế."
        }
      ],
      "expo-notifications"
    ]
  }
}
