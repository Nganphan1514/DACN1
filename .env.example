# (Tuy chon) Thong tin MySQL XAMPP chi dung khi chay scripts/migrate_mysql_to_supabase.py
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=he_thong_tai_xe

# Flask & JWT Secrets (doi gia tri manh khi trien khai thuc te)
